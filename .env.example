NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=example_database
TRENDS_COLLECTIONS=zone_1,zone_2,zone_3
SERVICE_TOKENS=project-a:replace-with-service-token-a,project-b:replace-with-service-token-b
TRENDS_PROJECT_COLLECTIONS=project-a:zone_1|zone_2,project-b:zone_3
JWT_SECRET=replace-with-a-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
NODERED_URL=http://127.0.0.1:1880/packages_status